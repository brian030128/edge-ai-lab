          "role": { "zh": "博士班四年級", "en": "Fourth-year PhD student" },
          "focus": [
            { "zh": "量化誤差分析", "en": "Quantisation error analysis" },
            { "zh": "低位元推論", "en": "Low-bit inference" }
          ],
          "work": {
            "zh": "研究量化誤差如何在深層網路中累積，並提出以逐層誤差預算取代統一位元寬度的配置方法。2026 年 ASPLOS 最佳論文。",
            "en": "Studies how quantisation error accumulates through a deep network, and replaces uniform bit widths with a per-layer error budget. Best paper at ASPLOS 2026."
          },
          "email": "phchen@example.edu.tw",
          "links": [{ "label": { "zh": "個人網頁", "en": "Homepage" }, "href": "https://example.edu.tw/~phchen" }]
