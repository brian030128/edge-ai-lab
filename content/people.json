          "name": { "zh": "許維宸", "en": "Wei-Chen Hsu" },
          "role": { "zh": "博士後研究員　2025 年起", "en": "Postdoctoral researcher, since 2025" },
          "focus": [
            { "zh": "編譯器後端", "en": "Compiler backends" },
