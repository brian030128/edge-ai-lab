            { "zh": "MLIR" , "en": "MLIR" }
          ],
          "work": {
            "zh": "負責實驗室編譯器工具鏈的維護，目前在做跨算子的記憶體重用分析，讓小型 NPU 不必把中間張量寫回 DRAM。",
            "en": "Maintains the lab's compiler toolchain. Currently working on cross-operator memory reuse analysis so small NPUs never have to spill intermediate tensors to DRAM."
          },
          "email": "wchsu@example.edu.tw",
          "links": [{ "label": "GitHub", "href": "https://github.com/example-lab" }]
        }
      ]
    },
